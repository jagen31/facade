#lang rhombus/and_meta

// =====================================================================
// facade -- the core of Art 4, in Rhombus.
//
// A faithful port of art3's core (art/private/core.rkt): a COMPILE-TIME
// metaprogramming system over *syntax objects*.  Art forms are Rhombus
// syntax; each form carries an identity context (a group property: the
// list of coordinate syntaxes it sits under).  The engine rewrites that
// syntax at expansion time, exactly as art3 does.
//
//   - object / coordinate / rewriter / embedding: names bound in the
//     `af` space to a compile-time kind (art3's `define-syntax name
//     (object/s)`), retrieved with `syntax_meta.value` (art3's
//     `syntax-local-value`)
//   - identity context: a `group_property` on each form's syntax
//   - the @-form `at [coord, ...]: body` merges coordinates downward
//   - a coordinate's merge / within? rules travel with its binding, so
//     they are visible wherever the coordinate is (no phase-fragile
//     global registry)
//   - realizers: `realize name: body` rewrites, then runs the realizer
// =====================================================================

space.transform af:
  space_path facade/af
  bridge_definer bind
  meta_namespace af_meta:
    reflection space

export:
  meta:
    head_of
    head_id_of
    args_of
    body_of
    get_ctxt
    set_ctxt
    kind_of
    context_ref
    context_ref_all
    context_ref_surrounding
    context_ref_within
    remove_from_ctxt
    put_in_ctxt
    merge_coordinates
    context_within
    art_id_of
    delete_expr
    current_ctxt
    lookup_ctxt
    run_art_exprs
    rewrite
  define_object
  define_art
  define_coordinate
  define_rewriter
  define_embedding
  define_realizer
  realize

// ---------------------------------------------------------------------
// kinds -- the compile-time value bound to each art-form name.
// A coordinate carries its own merge / within? rules (each a function
// or #false).
// ---------------------------------------------------------------------

meta:
  class ObjectKind()
  // merge/within: (l*, r*, l, r, ctxt) -> Syntax / Boolean;
  // nonhom: (left, right, ctxt) -> right'  (may look at / drop other coords)
  class CoordinateKind(merge, within, nonhom)
  class RewriterKind(body)             // (Syntax) -> List(Syntax)
  class EmbeddingKind(compile)         // (Syntax) -> List(Syntax)
  class RealizerKind(body)             // (List) -> Syntax
  class ArtVarKind(exprs)              // a rewritten program, spliced on reference

// ---------------------------------------------------------------------
// syntax utilities -- head, args, and the identity-context property
// ---------------------------------------------------------------------

meta:
  fun head_of(stx):
    match stx | '$(h :: Identifier) $_ ...': h.unwrap() | ~else: #false
  fun head_id_of(stx):
    match stx | '$(h :: Identifier) $_ ...': h | ~else: #false
  fun args_of(stx):
    match stx | '$_ $arg ...': [arg, ...] | ~else: []
  // the groups of a block body, for a form like `head: g; ...`
  fun body_of(stx):
    match stx | '$_ ...: $g; ...': [g, ...] | ~else: []

  // identity context: a list of coordinate syntaxes, on a group property
  fun get_ctxt(stx): stx.group_property(#'id_ctxt) || []
  fun set_ctxt(stx, ctxt): stx.group_property(#'id_ctxt, ctxt, #true)

  // look up a name's kind in the af space (art3's syntax-local-value)
  fun kind_of(name_stx):
    syntax_meta.value(name_stx, af_meta.space, fun (): #false)
  // the CoordinateKind for a coordinate syntax, or #false
  fun coord_kind(coord):
    def h = head_id_of(coord)
    if h | kind_of(h) | #false

// ---------------------------------------------------------------------
// context utilities -- a context is a `List` of form syntaxes
// ---------------------------------------------------------------------

meta:
  fun context_ref_all(ctxt, name):
    ctxt.filter(~keep: fun (e): head_of(e) == name)
  fun context_ref(ctxt, name):
    def r = context_ref_all(ctxt, name)
    if r.length() == 0 | #false | r[0]
  fun remove_from_ctxt(ctxt, name):
    ctxt.filter(~keep: fun (e): head_of(e) != name)
  fun put_in_ctxt(ctxt, e):
    [e] ++ remove_from_ctxt(ctxt, head_of(e))
  // forms of type `name` whose coordinates *contain* `coords`, nearest first
  fun context_ref_surrounding(ctxt, coords, name):
    def cands = ctxt.filter(~keep: fun (e): head_of(e) == name && context_within(coords, get_ctxt(e), ctxt))
    cands.sort(fun (l, r): context_within(get_ctxt(l), get_ctxt(r), ctxt))
  // forms of type `name` *contained by* `coords`
  fun context_ref_within(ctxt, coords, name):
    ctxt.filter(~keep: fun (e): head_of(e) == name && context_within(get_ctxt(e), coords, ctxt))
  // distinct coordinate heads across two contexts, as (symbol, syntax) so
  // we can both compare and look up the kind
  fun coord_names(left, right):
    for values(acc = []) (c in (left ++ right)):
      def n = head_of(c)
      if acc.filter(~keep: fun (p): p[0] == n).length() > 0 | acc | acc ++ [[n, c]]

// ---------------------------------------------------------------------
// coordinate merge + within?  -- driven by each coordinate's own rules,
// looked up from its binding (expansion-consistent, no global registry)
// ---------------------------------------------------------------------

meta:
  // merge coordinate list `left` into `right`, applying each present
  // coordinate's merge rule (mirrors art3's merge-coordinates)
  fun merge_coordinates(left, right, ctxt):
    for values(acc = right) (pair in coord_names(left, right)):
      def name = pair[0]
      def k = coord_kind(pair[1])
      match k
      | c :: CoordinateKind:
          def m = c.merge
          def l_star = context_ref(left, name)
          def r_star = context_ref(acc, name)
          // homogeneous merge of this coordinate; with no merge rule the
          // default is to carry it (inner/right wins, else outer/left)
          def acc2:
            if l_star || r_star
            | put_in_ctxt(acc, if m | m(l_star, r_star, left, acc, ctxt) | (r_star || l_star))
            | acc
          // then this coordinate's non-homogeneous rule (may drop/modify
          // *other* coordinates), given the whole left and right contexts
          def nh = c.nonhom
          if nh | nh(left, acc2, ctxt) | acc2
      | ~else: acc

  // is context `l` within context `r`?  each coordinate's within? rule
  // must agree; a coordinate present on one side only follows art3's rule
  fun context_within(l, r, ctxt):
    for values(acc = #true) (pair in coord_names(l, r)):
      def name = pair[0]
      def k = coord_kind(pair[1])
      def ok:
        match k
        | c :: CoordinateKind:
            def l_star = context_ref(l, name)
            def r_star = context_ref(r, name)
            cond
            | l_star && !r_star: #true
            | r_star && !l_star: #false
            | l_star && r_star && c.within: (c.within)(l_star, r_star, l, r, ctxt)
            | ~else: #true
        | ~else: #true
      acc && ok

// ---------------------------------------------------------------------
// current + lookup contexts (art3's phase-1 parameters)
// ---------------------------------------------------------------------

meta:
  def current_ctxt_box = Box([])
  def lookup_ctxt_box = Box([])
  fun current_ctxt(): current_ctxt_box.value
  fun lookup_ctxt(): lookup_ctxt_box.value
  fun with_ctxts(cur, lk, thunk):
    def oc = current_ctxt_box.value
    def ol = lookup_ctxt_box.value
    current_ctxt_box.value := cur
    lookup_ctxt_box.value := lk
    def r = thunk()
    current_ctxt_box.value := oc
    lookup_ctxt_box.value := ol
    r

// ---------------------------------------------------------------------
// art-id -- a unique id coordinate assigned as a form lands
// ---------------------------------------------------------------------

meta:
  def id_counter = Box(0)
  fun fresh_id():
    id_counter.value := id_counter.value + 1
    id_counter.value
  fun ensure_id(expr):
    if context_ref(get_ctxt(expr), #'art_id)
    | expr
    | block:
        def n = Syntax.make(fresh_id())
        set_ctxt(expr, ['art_id $n'] ++ get_ctxt(expr))
  fun rebuild_embedding(expr, inner):
    ensure_id(expr).group_property(#'inner, inner, #true)
  // the art-id value of a form (a syntax term), or #false
  fun art_id_of(e):
    def c = context_ref(get_ctxt(e), #'art_id)
    if c | args_of(c)[0] | #false
  fun id_eq(a, b): a && b && a.unwrap() == b.unwrap()
  // a `delete_by_id` instruction that removes `e` (for rewriters)
  fun delete_expr(e):
    def id = art_id_of(e)
    'delete_by_id $id'

// ---------------------------------------------------------------------
// the rewriting engine (compile time, over syntax)
// ---------------------------------------------------------------------

meta:
  fun run_art_exprs(exprs, ctxt, lk_ctxt):
    for values(acc = ctxt) (expr in exprs):
      run_art_expr(expr, acc, acc ++ lk_ctxt)

  fun run_art_expr(expr, ctxt, lk_ctxt):
    match expr
    // the @-form: `at [coord, ...]: inner; ...` -- merge coordinates down
    | 'at [$coord, ...]: $inner; ...':
        def merged = merge_coordinates(get_ctxt(expr), [coord, ...], current_ctxt())
        fun push(b): set_ctxt(b, merge_coordinates(merged, get_ctxt(b), current_ctxt()))
        run_art_exprs([inner, ...].map(push), ctxt, lk_ctxt)
    // delete every form carrying the given art-id
    | 'delete_by_id $the_id':
        ctxt.filter(~keep: fun (e): !id_eq(art_id_of(e), the_id))
    // discard the whole context and rewrite the body fresh
    | 'replace_full_context: $g; ...':
        run_art_exprs([g, ...], [], [])
    | ~else:
        def hid = head_id_of(expr)
        match (if hid | kind_of(hid) | #false)
        | rw :: RewriterKind:
            def out = with_ctxts(ctxt, lk_ctxt, fun (): (rw.body)(ensure_id(expr)))
            run_art_exprs(out, ctxt, lk_ctxt)
        | em :: EmbeddingKind:
            def inner = with_ctxts(ctxt, lk_ctxt, fun (): (em.compile)(expr))
            ctxt ++ [rebuild_embedding(expr, inner)]
        | av :: ArtVarKind:
            // splice the stored program, merging the reference's coords in
            fun pull(e): set_ctxt(e, merge_coordinates(get_ctxt(expr), get_ctxt(e), current_ctxt()))
            run_art_exprs((av.exprs).map(pull), ctxt, lk_ctxt)
        | ob :: ObjectKind: ctxt ++ [ensure_id(expr)]
        | co :: CoordinateKind: ctxt ++ [ensure_id(expr)]
        | ~else: syntax_meta.error("run_art_expr: unknown art form", expr)

  fun rewrite(exprs):
    run_art_exprs(exprs, [], [])

// ---------------------------------------------------------------------
// surface: definers and the realize form
// ---------------------------------------------------------------------

defn.macro 'define_object $(name :: Identifier)':
  'af.bind $name: ObjectKind()'

// define_art name: <program>  -- rewrite the body now and bind `name` to
// it; a later reference to `name` in a program splices it in (art3's
// define-art variable).
defn.macro 'define_art $(name :: Identifier): $g; ...':
  'af.bind $name: ArtVarKind(rewrite(['$g', ...]))'

// define_coordinate name                 -- a plain coordinate
// define_coordinate name:                 -- with rules, each a fun
//   merge:  fun (l_star, r_star, l, r, ctxt): ...   // -> Syntax
//   within: fun (l_star, r_star, l, r, ctxt): ...   // -> Boolean
defn.macro
| 'define_coordinate $(name :: Identifier): $clause; ...':
    // the body groups of the `kw:` clause, or #false
    fun body_for(kw):
      for values(found = #false) (cl in [clause, ...]):
        match cl
        | '$(k :: Identifier): $bg; ...':
            if k.unwrap() == kw | [bg, ...] | found
        | ~else: found
    def mg = body_for(#'merge)
    def wg = body_for(#'within)
    def ng = body_for(#'nonhom)
    def mf_stx = if mg | (block: let [g, ...] = mg; 'def mf: $g; ...') | 'def mf = #false'
    def wf_stx = if wg | (block: let [g, ...] = wg; 'def wf: $g; ...') | 'def wf = #false'
    def nf_stx = if ng | (block: let [g, ...] = ng; 'def nf: $g; ...') | 'def nf = #false'
    'af.bind $name:
       $mf_stx
       $wf_stx
       $nf_stx
       CoordinateKind(mf, wf, nf)'
| 'define_coordinate $(name :: Identifier)':
    'af.bind $name: CoordinateKind(#false, #false, #false)'

defn.macro 'define_rewriter $(name :: Identifier): $g; ...':
  'af.bind $name:
     def the_fn: $g; ...
     RewriterKind(the_fn)'
defn.macro 'define_embedding $(name :: Identifier): $g; ...':
  'af.bind $name:
     def the_fn: $g; ...
     EmbeddingKind(the_fn)'
defn.macro 'define_realizer $(name :: Identifier): $g; ...':
  'af.bind $name:
     def the_fn: $g; ...
     RealizerKind(the_fn)'

// realize rname: <program block>  -- rewrite the program (compile time),
// run the realizer, and pack its result as a literal in the use site's
// lexical context.  A realizer returns an ordinary value (e.g. a string
// of generated code), art3-style.
expr.macro 'realize $(rname :: Identifier): $prog; ...':
  def k = syntax_meta.value(rname, af_meta.space, fun (): #false)
  def ctxt = rewrite([prog, ...])
  Syntax.make((k.body)(ctxt), rname)
