#lang rhombus/and_meta

space.transform af:
  space_path facade/af
  bridge_definer bind
  meta_namespace af_meta:
    reflection space

import:
  meta:
    "interp.rhm" open

export:
  meta:
    ObjectKind CoordinateKind RewriterKind EmbeddingKind RealizerKind ArtVarKind
    head_of head_id_of args_of body_of get_ctxt set_ctxt
    kind_of coord_kind kind_lookup current_kind_lookup with_kind_lookup
    install_default_kind_lookup
    context_ref context_ref_all context_ref_all_nested context_ref_surrounding context_ref_within
    remove_from_ctxt put_in_ctxt coord_names
    get_context require_context remove_from_id_ctxt put_in_id_ctxt rewrite_in
    merge_coordinates context_within
    current_ctxt lookup_ctxt with_ctxts
    fresh_id ensure_id rebuild_embedding art_id_of id_eq delete_expr delete_exprs
    run_art_exprs run_art_expr rewrite value_to_syntax
  define_object
  define_art
  define_coordinate
  define_rewriter
  define_mapping_rewriter
  define_embedding
  define_realizer
  realize
  rewrite_nested

meta:
  install_default_kind_lookup(fun (name): syntax_meta.value(name, af_meta.space, fun (): #false))

defn.macro 'define_object $(name :: Identifier)':
  'af.bind $name: ObjectKind()'

defn.macro 'define_art $(name :: Identifier): $g; ...':
  'af.bind $name: ArtVarKind(rewrite(['$g', ...]))'

defn.macro
| 'define_coordinate $(name :: Identifier): $clause; ...':
    fun body_for(kw):
      for values(found = #false) (cl in [clause, ...]):
        match cl
        | '$(k :: Identifier): $bg; ...':
            if k.unwrap() == kw | [bg, ...] | found
        | ~else: found
    def mg = body_for(#'merge)
    def wg = body_for(#'within)
    def ng = body_for(#'nonhom)
    def mf_stx = if mg | (block: let [g, ...] = mg; 'def mf: $g; ...') | 'def mf = #false'
    def wf_stx = if wg | (block: let [g, ...] = wg; 'def wf: $g; ...') | 'def wf = #false'
    def nf_stx = if ng | (block: let [g, ...] = ng; 'def nf: $g; ...') | 'def nf = #false'
    'af.bind $name:
       $mf_stx
       $wf_stx
       $nf_stx
       CoordinateKind(mf, wf, nf)'
| 'define_coordinate $(name :: Identifier)':
    'af.bind $name: CoordinateKind(#false, #false, #false)'

defn.macro 'define_rewriter $(name :: Identifier): $g; ...':
  'af.bind $name:
     def the_fn: $g; ...
     RewriterKind(the_fn)'

defn.macro 'define_mapping_rewriter $(name :: Identifier) over $(head :: Identifier): $g; ...':
  'af.bind $name:
     def the_body: $g; ...
     fun the_rw(stx):
       def melodies = context_ref_within(current_ctxt(), get_ctxt(stx), #'$head)
       def outs = List.append(& melodies.map(fun (m): the_body(stx, m)))
       [delete_exprs(melodies)] ++ outs
     RewriterKind(the_rw)'
defn.macro 'define_embedding $(name :: Identifier): $g; ...':
  'af.bind $name:
     def the_fn: $g; ...
     EmbeddingKind(the_fn)'
defn.macro 'define_realizer $(name :: Identifier): $g; ...':
  'af.bind $name:
     def the_fn: $g; ...
     RealizerKind(the_fn)'

expr.macro 'realize $(rname :: Identifier): $prog; ...':
  def k = syntax_meta.value(rname, af_meta.space, fun (): #false)
  def ctxt = rewrite([prog, ...])
  value_to_syntax((k.body)(ctxt), rname)

define_rewriter rewrite_nested:
  fun (stx):
    def body = body_of(stx)
    def [b, ...] = body
    def embs = current_ctxt().filter(~keep: fun (e): def hid = head_id_of(e); hid && (kind_of(hid) is_a EmbeddingKind))
    def rebuilt = for List (e in embs):
      def hid = head_id_of(e)
      def items = e.group_property(#'inner) || []
      def [it, ...] = rewrite_in(items, ['rewrite_nested: $b ; ...'])
      set_ctxt('$hid: $it ; ...', get_ctxt(e))
    def replacements = [delete_exprs(embs)] ++ rebuilt
    body ++ replacements
