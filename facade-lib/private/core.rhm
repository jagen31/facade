#lang rhombus/and_meta

// =====================================================================
// facade -- the surface of Art 4, in Rhombus.
//
// The engine itself now lives at PHASE 0, in `interp.rhm`, abstracted
// over a name->kind lookup.  This module is the phase-1 skin around it:
//
//   - the `af` space, in which object / coordinate / rewriter / embedding
//     / realizer names are bound to a compile-time kind
//   - the surface definers (`define_object`, `define_coordinate`,
//     `define_rewriter`, ...) and the `realize` form
//
// It `import`s the interpreter AT PHASE 1 (so these macros can run it
// during expansion), re-exports it AT PHASE 1 (so client rewriter /
// realizer / coordinate bodies, and the generated `af.bind` right-hand
// sides, can use it), and installs the phase-1 lookup: art3's
// `syntax-local-value` over the `af` space, as `syntax_meta.value`.
// Because the lookup is a parameter, the same engine runs unchanged at
// phase 0 with a different lookup installed.
// =====================================================================

space.transform af:
  space_path facade/af
  bridge_definer bind
  meta_namespace af_meta:
    reflection space

// the phase-0 engine, brought up to phase 1 for use in the macros below
import:
  meta:
    "interp.rhm" open

export:
  // re-export the whole engine at phase 1, for client meta code and for
  // the `af.bind` right-hand sides the definers expand into
  meta:
    ObjectKind CoordinateKind RewriterKind EmbeddingKind RealizerKind ArtVarKind
    head_of head_id_of args_of body_of get_ctxt set_ctxt
    kind_of coord_kind kind_lookup current_kind_lookup with_kind_lookup
    install_default_kind_lookup
    context_ref context_ref_all context_ref_surrounding context_ref_within
    remove_from_ctxt put_in_ctxt coord_names
    get_context require_context remove_from_id_ctxt put_in_id_ctxt rewrite_in
    merge_coordinates context_within
    current_ctxt lookup_ctxt with_ctxts
    fresh_id ensure_id rebuild_embedding art_id_of id_eq delete_expr
    run_art_exprs run_art_expr rewrite value_to_syntax
  define_object
  define_art
  define_coordinate
  define_rewriter
  define_mapping_rewriter
  define_embedding
  define_realizer
  realize

// Make the `kind_lookup` parameter *default* to art3's syntax-local-value
// over the `af` space: fill in the default the parameter falls back to.
// `syntax_meta.value` is only valid inside expansion, but here we merely
// *store the closure*; it is called later -- during `rewrite` / `realize`
// / `af.bind` expansion -- when there is an expansion context.  A phase-0
// client overrides `kind_lookup` (via `with_kind_lookup` / `parameterize`)
// to run the same engine against its own registry.
meta:
  install_default_kind_lookup(fun (name): syntax_meta.value(name, af_meta.space, fun (): #false))

// ---------------------------------------------------------------------
// surface: definers and the realize form
// ---------------------------------------------------------------------

defn.macro 'define_object $(name :: Identifier)':
  'af.bind $name: ObjectKind()'

// define_art name: <program>  -- rewrite the body now and bind `name` to
// it; a later reference to `name` in a program splices it in (art3's
// define-art variable).
defn.macro 'define_art $(name :: Identifier): $g; ...':
  'af.bind $name: ArtVarKind(rewrite(['$g', ...]))'

// define_coordinate name                 -- a plain coordinate
// define_coordinate name:                 -- with rules, each a fun
//   merge:  fun (l_star, r_star, l, r, ctxt): ...   // -> Syntax
//   within: fun (l_star, r_star, l, r, ctxt): ...   // -> Boolean
defn.macro
| 'define_coordinate $(name :: Identifier): $clause; ...':
    // the body groups of the `kw:` clause, or #false
    fun body_for(kw):
      for values(found = #false) (cl in [clause, ...]):
        match cl
        | '$(k :: Identifier): $bg; ...':
            if k.unwrap() == kw | [bg, ...] | found
        | ~else: found
    def mg = body_for(#'merge)
    def wg = body_for(#'within)
    def ng = body_for(#'nonhom)
    def mf_stx = if mg | (block: let [g, ...] = mg; 'def mf: $g; ...') | 'def mf = #false'
    def wf_stx = if wg | (block: let [g, ...] = wg; 'def wf: $g; ...') | 'def wf = #false'
    def nf_stx = if ng | (block: let [g, ...] = ng; 'def nf: $g; ...') | 'def nf = #false'
    'af.bind $name:
       $mf_stx
       $wf_stx
       $nf_stx
       CoordinateKind(mf, wf, nf)'
| 'define_coordinate $(name :: Identifier)':
    'af.bind $name: CoordinateKind(#false, #false, #false)'

defn.macro 'define_rewriter $(name :: Identifier): $g; ...':
  'af.bind $name:
     def the_fn: $g; ...
     RewriterKind(the_fn)'

// define_mapping_rewriter name over head: fun (stx, obj): <list of exprs>
// -- art3's define-mapping-rewriter: find every form of type `head` within
// the rewriter's scope, delete them, and splice in `body(stx, obj)` for
// each (a list of exprs).  `stx` is the rewriter call; `obj` each match.
defn.macro 'define_mapping_rewriter $(name :: Identifier) over $(head :: Identifier): $g; ...':
  'af.bind $name:
     def the_body: $g; ...
     fun the_rw(stx):
       def melodies = context_ref_within(current_ctxt(), get_ctxt(stx), #'$head)
       def dels = melodies.map(delete_expr)
       def outs = for values(acc = []) (m in melodies): acc ++ the_body(stx, m)
       dels ++ outs
     RewriterKind(the_rw)'
defn.macro 'define_embedding $(name :: Identifier): $g; ...':
  'af.bind $name:
     def the_fn: $g; ...
     EmbeddingKind(the_fn)'
defn.macro 'define_realizer $(name :: Identifier): $g; ...':
  'af.bind $name:
     def the_fn: $g; ...
     RealizerKind(the_fn)'

// realize rname: <program block>  -- rewrite the program (compile time),
// run the realizer, and pack its result as a literal in the use site's
// lexical context.  A realizer returns an ordinary value (e.g. a string
// of generated code), art3-style.
expr.macro 'realize $(rname :: Identifier): $prog; ...':
  def k = syntax_meta.value(rname, af_meta.space, fun (): #false)
  def ctxt = rewrite([prog, ...])
  value_to_syntax((k.body)(ctxt), rname)
