#lang rhombus/and_meta
import: "../private/core.rhm" open

define_object note

// interval coordinate: nesting translates its start
define_coordinate interval ~merge:
  fun (l_star, r_star, l, r, ctxt):
    cond
    | l_star && r_star:
        def ls = args_of(l_star)[0].unwrap()
        def ns = Syntax.make(ls + args_of(r_star)[0].unwrap())
        def ne = Syntax.make(ls + args_of(r_star)[1].unwrap())
        'interval $ns $ne'
    | ~else: (r_star || l_star)

// realizer: describe each note as pitch@start..end
define_realizer pitches:
  fun (ctxt):
    fun desc(n):
      def p = to_string(args_of(n)[0].unwrap())
      def iv = context_ref(get_ctxt(n), #'interval)
      def ivs = if iv | (to_string(args_of(iv)[0].unwrap()) +& ".." +& to_string(args_of(iv)[1].unwrap())) | "-"
      p +& "@" +& ivs
    def parts = context_ref_all(ctxt, #'note).map(desc)
    for values(acc = "") (s in parts): acc +& (if acc == "" | "" | "  ") +& s

def result = realize pitches:
               note c 0 5
               at [interval 0 4]:
                 note c 0 5
                 note d 0 5
               at [interval 10 20]:
                 at [interval 0 4]:
                   note e 0 5

println(result)

// --- rewriter + embedding ---
define_rewriter two_notes:
  fun (expr):
    ['note c 0 5', 'note g 0 5']    // expands to two notes

define_embedding music:
  fun (expr):
    rewrite(body_of(expr))          // rewrites its own body behind a barrier

define_realizer count_notes:
  fun (ctxt): context_ref_all(ctxt, #'note).length()

def rw = realize count_notes:
           two_notes
           note c 0 5
println("rewriter expanded to note count: " +& to_string(rw))

define_realizer count_music:
  fun (ctxt):
    def m = context_ref(ctxt, #'music)
    if m | (m.group_property(#'inner)).length() | 0
def em = realize count_music:
           music:
             note c 0 5
             note d 0 5
println("embedding rewrote inner forms: " +& to_string(em))
