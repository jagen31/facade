#lang rhombus/static

// facade -- the public entry point.  Re-exports the core engine and the
// standard coordinate library so a client can `import: facade` and get
// everything.

import:
  "private/core.rhm"
  "coordinates.rhm"
  "sequence.rhm"

export:
  all_from(.core)
  all_from(.coordinates)
  all_from(.sequence)
